/* VARIABLES & CONFIGURAÇÕES GERAIS */
:root {
  --bg: #0f172a;
  --card-bg: #1e293b;
  --primary: #00c853;
  --secondary: #38bdf8;
  --text: #f8fafc;
  --text-muted: #94a3b8;
  --border: #334155;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.6;
  padding: 20px;
}

/* CABEÇALHO */
header {
  text-align: center;
  padding: 40px 0;
  max-width: 800px;
  margin: 0 auto;
}

header h1 {
  font-size: 2.5rem;
  color: var(--primary);
  margin-bottom: 10px;
}

header p {
  color: var(--text-muted);
  font-size: 1.1rem;
}

/* GRID DE CONTEUDO */
.container {
  max-width: 1000px;
  margin: 0<link rel="stylesheet" href="style.css"> auto;
  display: grid;
  grid: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  padding: 20px 0;
}

.card {
  background-color: var(--card-bg);
  border-radius: 8px;
  padding: 24px;
  border: 1px solid var(--border);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--secondary);
}

.card h2 {
  font-size: 1.4rem;
  margin-bottom: 12px;
  color: var(--secondary);
}

.card p {
  color: #cbd5e1;
  font-size: 0.95rem;
  margin-bottom: 15px;
}

/* SEÇÃO INTERATIVA */
.interactive-section {
  max-width: 1000px;
  margin: 40px auto;
  background-color: var(--card-bg);
  padding: 24px;
  border-radius: 8px;
  border: 1px solid var(--border);
}

.interactive-section h2 {
  margin-bottom: 15px;
  color: var(--primary);
}

button {
  background-color: var(--primary);
  color: #000;
  border: none;
  padding: 10px 20px;
  font-weight: bold;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s;
  margin-right: 10px;
}

button:hover {
  opacity: 0.9;
}

#quiz-result {
  margin-top: 15px;
  font-weight: bold;
  color: var(--secondary);
}

/* RODAPÉ */
footer {
  text-align: center;
  padding: 20px;
  color: var(--text-muted);
  font-size: 0.85rem;
  border-top: 1px solid var(--border);
  margin-top: 40px;
}